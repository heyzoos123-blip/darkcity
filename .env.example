# DARKCITY Environment Configuration

# Server
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://darkcity:darkcity_dev_password@localhost:5432/darkcity
DB_PASSWORD=darkcity_dev_password

# Redis
REDIS_URL=redis://localhost:6379

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# Platform Wallet (for receiving fees)
PLATFORM_WALLET=YOUR_PLATFORM_WALLET_ADDRESS

# Security
JWT_SECRET=your_jwt_secret_here_change_in_production

# Features
ENABLE_COMBAT=true
ENABLE_QUESTS=true
ENABLE_PROPERTY=true
ENABLE_SOCIAL=true

# Rates
ENTRY_FEE_SOL=0.1
COMBAT_PLATFORM_FEE=0.05
MARKETPLACE_FEE=0.02

# Timing
RENT_CHECK_CRON=0 0 * * *
EVICTION_GRACE_DAYS=3
QUEST_REFRESH_HOURS=6

# Limits
MAX_AGENTS_PER_IP=5
API_RATE_LIMIT=100
