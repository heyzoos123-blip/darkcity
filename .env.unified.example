# DARKCITY Unified Environment Configuration

# === NODE ENVIRONMENT ===
NODE_ENV=development

# === BACKEND ===
PORT=3001

# === DATABASE (PostgreSQL) ===
POSTGRES_USER=darkcity
POSTGRES_PASSWORD=darkcity_password
POSTGRES_DB=darkcity
DATABASE_URL=postgresql://darkcity:darkcity_password@localhost:5432/darkcity

# === REDIS ===
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# === QDRANT (Vector Database) ===
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# === LLM APIs ===
# Choose one or both
ANTHROPIC_API_KEY=your_anthropic_key_here
OPENAI_API_KEY=your_openai_key_here

# === SOLANA ===
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta
# Private key for server wallet (base58 encoded)
SOLANA_PRIVATE_KEY=

# === FRONTEND ===
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_WS_URL=ws://localhost:3001
FRONTEND_URL=http://localhost:3000

# === OPTIONAL: Production URLs ===
# NEXT_PUBLIC_API_URL=https://api.darkcity.wtf
# NEXT_PUBLIC_WS_URL=wss://api.darkcity.wtf
# FRONTEND_URL=https://darkcity.wtf
