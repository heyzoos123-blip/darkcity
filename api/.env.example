# Server Configuration
PORT=3000
NODE_ENV=development

# Database (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/darkcity

# Redis (optional, for distributed rate limiting)
REDIS_URL=redis://localhost:6379

# CORS (if needed for browser clients)
CORS_ORIGIN=https://darkcity.game

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090

# Security
MAX_SIGNATURE_AGE_SECONDS=300
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
ACTION_RATE_LIMIT_WINDOW_MS=10000
ACTION_RATE_LIMIT_MAX_REQUESTS=10

# WebSocket
WS_PING_INTERVAL_MS=30000
WS_MAX_CLIENTS_PER_BATTLE=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
