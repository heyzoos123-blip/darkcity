# DARKCITY Memory System - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# PostgreSQL Configuration
# ============================================================================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=darkcity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# ============================================================================
# Redis Configuration
# ============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# Qdrant Vector Database
# ============================================================================

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# ============================================================================
# LLM Configuration
# Choose one or both (Anthropic for consolidation, OpenAI for embeddings)
# ============================================================================

# Anthropic Claude (recommended for consolidation)
ANTHROPIC_API_KEY=your_anthropic_key

# OpenAI (required for embeddings, optional for consolidation)
OPENAI_API_KEY=your_openai_key

# ============================================================================
# Optional: Production Settings
# ============================================================================

# Node environment
NODE_ENV=development

# Logging level
LOG_LEVEL=info

# Consolidation schedule (cron expression)
CONSOLIDATION_SCHEDULE=0 4 * * *

# Maximum concurrent consolidations
CONSOLIDATION_CONCURRENCY=100

# Memory retention (days)
MEMORY_RETENTION_DAYS=90
