# ==============================================================================
# DARKCITY DATABASE CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL Configuration
# ------------------------------------------------------------------------------

# Primary database connection
DATABASE_URL="postgresql://darkcity:password@localhost:5432/darkcity?schema=public"

# Database host and port
DB_HOST=localhost
DB_PORT=5432
DB_NAME=darkcity
DB_USER=darkcity
DB_PASSWORD=your_secure_password_here

# SSL Configuration (required for production)
# DB_SSL_CA=/path/to/ca-certificate.crt

# Read replicas (comma-separated URLs)
# DB_READ_REPLICAS=postgresql://replica1:5432/darkcity,postgresql://replica2:5432/darkcity

# ------------------------------------------------------------------------------
# Connection Pool Settings
# ------------------------------------------------------------------------------

# Maximum number of connections in the pool
DB_POOL_MAX=20

# Minimum number of connections in the pool
DB_POOL_MIN=5

# Maximum time (ms) a client can be idle before being removed
DB_IDLE_TIMEOUT=30000

# Maximum time (ms) to wait for a connection before timing out
DB_CONNECTION_TIMEOUT=5000

# Maximum time (ms) a query can run before being cancelled
DB_STATEMENT_TIMEOUT=30000

# ------------------------------------------------------------------------------
# Query Logging
# ------------------------------------------------------------------------------

# Enable database query logging
DB_LOGGING_ENABLED=false

# Log queries slower than this threshold (ms)
DB_SLOW_QUERY_THRESHOLD=1000

# ------------------------------------------------------------------------------
# Redis Configuration
# ------------------------------------------------------------------------------

# Redis connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis cluster mode (for production)
REDIS_CLUSTER_ENABLED=false
# REDIS_CLUSTER_NODES=redis1:6379,redis2:6379,redis3:6379

# ------------------------------------------------------------------------------
# Application Settings
# ------------------------------------------------------------------------------

# Environment (development | staging | production)
NODE_ENV=development

# Server port
PORT=3000

# API base URL
API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------

# JWT secret for authentication
JWT_SECRET=your_jwt_secret_here_change_in_production

# Session secret
SESSION_SECRET=your_session_secret_here_change_in_production

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# ------------------------------------------------------------------------------
# External Services
# ------------------------------------------------------------------------------

# OpenAI API Key (for AI features)
OPENAI_API_KEY=sk-...

# Anthropic API Key (alternative AI provider)
ANTHROPIC_API_KEY=

# Solana RPC URL
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# $DARKFLOBI Token Mint Address
DARKFLOBI_MINT=7GCxHtUttri1gNdt8Asa8DC72DQbiFNrN43ALjptpump

# ------------------------------------------------------------------------------
# Monitoring & Logging
# ------------------------------------------------------------------------------

# Sentry DSN (error tracking)
SENTRY_DSN=

# Log level (debug | info | warn | error)
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Feature Flags
# ------------------------------------------------------------------------------

# Enable memory consolidation (daily summary generation)
ENABLE_MEMORY_CONSOLIDATION=true

# Enable blockchain integration
ENABLE_BLOCKCHAIN=false

# Enable AI agent responses
ENABLE_AI_AGENTS=true

# ------------------------------------------------------------------------------
# Performance Tuning
# ------------------------------------------------------------------------------

# Cache TTL (seconds)
CACHE_TTL_AGENT=300
CACHE_TTL_DISTRICT=3600
CACHE_TTL_SESSION=86400

# Rate limiting
RATE_LIMIT_WINDOW=60
RATE_LIMIT_MAX_REQUESTS=100
